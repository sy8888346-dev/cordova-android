<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>अत्याधुनिक AI सहायक</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #6e8efb;
            --secondary: #a777e3;
            --accent: #ff6b6b;
            --light: #f8f9fa;
            --dark: #343a40;
            --success: #28a745;
            --info: #17a2b8;
            --warning: #ffc107;
            --danger: #dc3545;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', 'Arial', sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #6e8efb, #a777e3);
            color: #333;
            min-height: 100vh;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        header {
            text-align: center;
            margin-bottom: 30px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(31, 38, 135, 0.2);
        }
        
        h1 {
            font-size: 2.5rem;
            color: #fff;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
            margin-bottom: 10px;
        }
        
        .tagline {
            font-size: 1.2rem;
            color: #e6e6e6;
            margin-bottom: 20px;
        }
        
        .main-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        
        @media (max-width: 900px) {
            .main-content {
                grid-template-columns: 1fr;
            }
        }
        
        .features-section {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 8px 32px rgba(31, 38, 135, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }
        
        .section-title {
            font-size: 1.5rem;
            margin-bottom: 20px;
            color: #2c3e50;
            text-align: center;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--primary);
        }
        
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }
        
        .feature-card {
            background: rgba(255, 255, 255, 0.4);
            border-radius: 12px;
            padding: 15px;
            transition: transform 0.3s ease;
            cursor: pointer;
        }
        
        .feature-card:hover {
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.6);
        }
        
        .feature-icon {
            font-size: 1.8rem;
            margin-bottom: 10px;
            color: var(--primary);
        }
        
        .feature-title {
            font-size: 1.1rem;
            margin-bottom: 8px;
            color: #2c3e50;
        }
        
        .feature-desc {
            font-size: 0.9rem;
            color: #34495e;
        }
        
        .chat-interface {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 8px 32px rgba(31, 38, 135, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.18);
            display: flex;
            flex-direction: column;
        }
        
        .chat-box {
            height: 300px;
            overflow-y: auto;
            padding: 15px;
            background: rgba(255, 255, 255, 0.4);
            border-radius: 12px;
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
        }
        
        .message {
            padding: 10px 15px;
            border-radius: 18px;
            margin-bottom: 10px;
            max-width: 80%;
            word-wrap: break-word;
        }
        
        .ai-message {
            background: rgba(110, 142, 251, 0.2);
            border-top-left-radius: 4px;
            align-self: flex-start;
        }
        
        .user-message {
            background: rgba(167, 119, 227, 0.2);
            border-top-right-radius: 4px;
            align-self: flex-end;
            margin-left: auto;
        }
        
        .input-area {
            display: flex;
            gap: 10px;
        }
        
        input {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 50px;
            background: rgba(255, 255, 255, 0.4);
            font-size: 1rem;
        }
        
        button {
            padding: 12px 25px;
            border: none;
            border-radius: 50px;
            background: linear-gradient(135deg, #6e8efb, #a777e3);
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.2s ease;
        }
        
        button:hover {
            transform: scale(1.05);
        }
        
        .voice-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--info);
            color: white;
            border: none;
            cursor: pointer;
            font-size: 1.2rem;
        }
        
        .tools-section {
            margin-top: 30px;
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 8px 32px rgba(31, 38, 135, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }
        
        .tools-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
        }
        
        .tool-card {
            background: rgba(255, 255, 255, 0.4);
            border-radius: 12px;
            padding: 15px;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .tool-card:hover {
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.6);
        }
        
        .tool-icon {
            font-size: 2rem;
            margin-bottom: 10px;
            color: var(--secondary);
        }
        
        footer {
            text-align: center;
            margin-top: 40px;
            color: rgba(255, 255, 255, 0.8);
            padding: 20px;
        }
        
        .featured {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 0.8rem;
            margin-left: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>अत्याधुनिक AI सहायक <span class="featured">ChatGPT से बेहतर</span></h1>
            <p class="tagline">आपकी सभी ज़रूरतों का एकमात्र समाधान - टेक्स्ट, इमेज, वीडियो, ऑडियो और डेटा प्रोसेसिंग</p>
        </header>
        
        <div class="main-content">
            <div class="features-section">
                <h3 class="section-title">AI की मुख्य विशेषताएँ</h3>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-bolt"></i></div>
                        <h4 class="feature-title">तुरंत समाधान</h4>
                        <p class="feature-desc">किसी भी प्रश्न का सटीक और त्वरित उत्तर प्राप्त करें</p>
                    </div>
                    
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-tasks"></i></div>
                        <h4 class="feature-title">टास्क सॉल्विंग</h4>
                        <p class="feature-desc">अटके हुए कार्यों को हल करने में सहायता</p>
                    </div>
                    
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-paint-brush"></i></div>
                        <h4 class="feature-title">क्रिएटिव कंटेंट</h4>
                        <p class="feature-desc">मोटिवेशनल स्क्रिप्ट्स, हैशटैग, सोशल मीडिया पोस्ट्स</p>
                    </div>
                    
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-video"></i></div>
                        <h4 class="feature-title">वीडियो और इमेज एडिटिंग</h4>
                        <p class="feature-desc">फोटो एडिटिंग, वीडियो स्क्रिप्टिंग और कंटेंट बनाना</p>
                    </div>
                    
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-microphone"></i></div>
                        <h4 class="feature-title">वॉइस इंटरैक्शन</h4>
                        <p class="feature-desc">वॉइस कमांड्स, टेक्स्ट टू स्पीच, स्पीच टू टेक्स्ट</p>
                    </div>
                    
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-star"></i></div>
                        <h4 class="feature-title">मल्टी-फंक्शनालिटी</h4>
                        <p class="feature-desc">टेक्स्ट, इमेज, वीडियो या डाटा से जुड़ी सभी ज़रूरतें</p>
                    </div>
                </div>
            </div>
            
            <div class="chat-interface">
                <h3 class="section-title">AI सहायक से बातचीत करें</h3>
                <div class="chat-box" id="chatBox">
                    <div class="message ai-message">नमस्ते! मैं आपकी किस प्रकार सहायता कर सकता हूँ?</div>
                </div>
                <div class="input-area">
                    <input type="text" id="userInput" placeholder="अपना संदेश यहाँ टाइप करें...">
                    <button onclick="sendMessage()">भेजें</button>
                    <button class="voice-btn" onclick="toggleVoiceRecognition()"><i class="fas fa-microphone"></i></button>
                </div>
            </div>
        </div>
        
        <div class="tools-section">
            <h3 class="section-title">AI टूल्स</h3>
            <div class="tools-grid">
                <div class="tool-card">
                    <div class="tool-icon"><i class="fas fa-film"></i></div>
                    <h4>मोटिवेशनल वीडियो</h4>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon"><i class="fas fa-blog"></i></div>
                    <h4>ब्लॉग पोस्ट</h4>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon"><i class="fas fa-hashtag"></i></div>
                    <h4>सोशल मीडिया कैप्शन</h4>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon"><i class="fas fa-tv"></i></div>
                    <h4>वीडियो रेजोल्यूशन</h4>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon"><i class="fas fa-cube"></i></div>
                    <h4>3D वीडियो</h4>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon"><i class="fas fa-language"></i></div>
                    <h4>बहुभाषी</h4>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon"><i class="fas fa-seedling"></i></div>
                    <h4>खेती सलाह</h4>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon"><i class="fas fa-tree"></i></div>
                    <h4>पेड़-पौधे</h4>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon"><i class="fas fa-home"></i></div>
                    <h4>घर का नक्शा</h4>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon"><i class="fas fa-cloud-sun"></i></div>
                    <h4>मौसम</h4>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon"><i class="fas fa-business-time"></i></div>
                    <h4>व्यवसाय</h4>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon"><i class="fas fa-mobile-alt"></i></div>
                    <h4>ऐप निर्माण</h4>
                </div>
            </div>
        </div>
        
        <footer>
            <p>© 2023 अत्याधुनिक AI सहायक | सभी अधिकार सुरक्षित</p>
        </footer>
    </div>

    <script>
        // Chat functionality
        const chatBox = document.getElementById('chatBox');
        const userInput = document.getElementById('userInput');
        
        // Responses for different types of queries
        const responses = {
            greeting: "नमस्ते! मैं आपकी किस प्रकार सहायता कर सकता हूँ?",
            question: "यह एक बहुत अच्छा प्रश्न है। मेरे अनुसार, इसका उत्तर है: AI तकनीक भविष्य में मानव जीवन को और भी अधिक सुविधाजनक बना देगी।",
            task: "मैं इस कार्य में आपकी सहायता कर सकता हूँ। कृपया अधिक विवरण प्रदान करें ताकि मैं बेहतर समाधान दे सकूँ।",
            creative: "चलिए एक रचनात्मक सामग्री बनाते हैं! हैशटैग के साथ एक मोटिवेशनल पोस्ट: 'सफलता की ओर बढ़ते रहें! #सफलता #मोटिवेशन #जीवन'",
            editing: "वीडियो संपादन के लिए, मैं सुझाव देता हूँ कि आप एक engaging intro के साथ शुरुआत करें और clear audio का ध्यान रखें।",
            voice: "वॉइस इंटरैक्शन के लिए, मैं text-to-speech और speech-to-text तकनीक का उपयोग कर सकता हूँ।",
            farming: "खेती के लिए, मौसम के अनुसार आप गेहूं, धान, मक्का जैसी फसलें उगा सकते हैं।",
            plants: "पेड़-पौधे लगाने के लिए स्थानीय जलवायु के अनुकूल प्रजातियों का चयन करें और नियमित रूप से पानी दें।",
            weather: "आज का मौसम सामान्य रहेगा, हल्की धूप के साथ तापमान 25-30°C के बीच रहने की संभावना है।",
            business: "व्यवसाय शुरू करने के लिए सबसे पहले एक योजना बनाएं, बाजार का विश्लेषण करें और फिर धीरे-धीरे शुरुआत करें।",
            default: "मैं इस प्रश्न को समझ गया हूँ। कृपया थोड़ा और विवरण दें ताकि मैं आपको बेहतर सहायता प्रदान कर सकूँ।"
        };
        
        // Function to add message to chat
        function addMessage(message, isUser = false) {
            const messageDiv = document.createElement('div');
            messageDiv.classList.add('message');
            messageDiv.classList.add(isUser ? 'user-message' : 'ai-message');
            messageDiv.textContent = message;
            chatBox.appendChild(messageDiv);
            chatBox.scrollTop = chatBox.scrollHeight;
        }
        
        // Function to generate AI response
        function generateResponse(input) {
            input = input.toLowerCase();
            
            if (input.includes('नमस्ते') || input.includes('हैलो') || input.includes('hi')) {
                return responses.greeting;
            } else if (input.includes('?') || input.includes('प्रश्न') || input.includes('जानकारी')) {
                return responses.question;
            } else if (input.includes('कार्य') || input.includes('टास्क') || input.includes('मदद')) {
                return responses.task;
            } else if (input.includes('क्रिएटिव') || input.includes('सामग्री') || input.includes('मोटिवेशन')) {
                return responses.creative;
            } else if (input.includes('वीडियो') || input.includes('इमेज') || input.includes('एडिट')) {
                return responses.editing;
            } else if (input.includes('आवाज') || input.includes('वॉइस') || input.includes('बोल')) {
                return responses.voice;
            } else if (input.includes('खेती') || input.includes('फसल') || input.includes('किसान')) {
                return responses.farming;
            } else if (input.includes('पेड़') || input.includes('पौध') || input.includes('वृक्ष')) {
                return responses.plants;
            } else if (input.includes('मौसम') || input.includes('तापमान')) {
                return responses.weather;
            } else if (input.includes('व्यवसाय') || input.includes('बिजनेस')) {
                return responses.business;
            } else {
                return responses.default;
            }
        }
        
        // Function to send message
        function sendMessage() {
            if (userInput.value.trim() !== '') {
                addMessage(userInput.value, true);
                
                // Simulate AI thinking
                setTimeout(function() {
                    const response = generateResponse(userInput.value);
                    addMessage(response);
                }, 1000);
                
                userInput.value = '';
            }
        }
        
        // Event listener for Enter key
        userInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });
        
        // Voice recognition functionality
        let isListening = false;
        const recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
        recognition.lang = 'hi-IN';
        
        recognition.onresult = function(event) {
            const transcript = event.results[0][0].transcript;
            userInput.value = transcript;
            sendMessage();
        };
        
        recognition.onend = function() {
            if (isListening) {
                recognition.start();
            }
        };
        
        function toggleVoiceRecognition() {
            if (isListening) {
                recognition.stop();
                isListening = false;
                document.querySelector('.voice-btn').style.background = '';
            } else {
                recognition.start();
                isListening = true;
                document.querySelector('.voice-btn').style.background = 'var(--danger)';
            }
        }
        
        // Tool cards functionality
        const toolCards = document.querySelectorAll('.tool-card');
        toolCards.forEach(card => {
            card.addEventListener('click', function() {
                const toolName = this.querySelector('h4').textContent;
                addMessage(`आपने ${toolName} टूल का चयन किया है। मैं इसके बारे में अधिक जानकारी प्रदान कर सकता हूँ।`, true);
                
                setTimeout(function() {
                    addMessage(`${toolName} टूल का उपयोग करने के लिए, कृपया मुझे बताएं कि आप क्या बनाना चाहते हैं या किस प्रकार की सहायता चाहते हैं।`);
                }, 1000);
            });
        });
    </script>
</body>
</html>
